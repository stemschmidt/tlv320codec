{
    "cortex-debug.armToolchainPrefix": "arm-zephyr-eabi",
    // The paths have to match the versions in the selected Zephyr SDK, see .devcontainer/devcontainer.json
    "cortex-debug.armToolchainPath": "/opt/toolchains/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/",
    "cortex-debug.gdbPath": "/opt/toolchains/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
    "files.associations": {},
    "cortex-debug.variableUseNaturalFormat": true,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
    "C_Cpp.files.exclude": {
        "**/*": true,
        "zephyr/**": false
    },
    "editor.formatOnSave": true
}